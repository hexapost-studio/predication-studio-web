# ── Modèle IA (structuration) ─────────────────────────────────────────────
# Fournir AU MOINS une des trois clés. Sans LLM_PROVIDER/LLM_MODEL, l'app
# choisit automatiquement (anthropic > openrouter > openai).

# OpenRouter — une seule clé, modèles GRATUITS et PAYANTS (recommandé)
OPENROUTER_API_KEY=

# Anthropic direct (défaut : claude-sonnet-5)
ANTHROPIC_API_KEY=

# OpenAI direct
OPENAI_API_KEY=

# ── Gratuit ou payant ? ───────────────────────────────────────────────────
# L'app tourne à l'identique dans les deux cas : les contrôles de fidélité
# sont les mêmes. Un modèle plus faible échoue plus souvent aux contrôles
# (plus de reprises), il ne publiera JAMAIS un document non conforme.

# --- Option A : 100 % GRATUIT (0 €, carte bancaire non requise) ---
# Créer une clé sur openrouter.ai, puis choisir un modèle `:free` :
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   Autres modèles gratuits au catalogue (contexte ≥ 128k, nécessaire ici) :
#     openai/gpt-oss-20b:free · google/gemma-4-26b-a4b-it:free
#     nvidia/nemotron-3-nano-30b-a3b:free · nvidia/nemotron-nano-9b-v2:free
#   (le catalogue gratuit change souvent : liste à jour sur
#    openrouter.ai/models?max_price=0, filtrer contexte ≥ 128k)
#   Limites du palier gratuit : 20 requêtes/minute, 50 requêtes/JOUR.
#   Une prédication = 1 à 2 requêtes → ~25 prédications/jour, largement assez.
#   (Après 10 $ de crédits achetés UNE fois : 1 000 requêtes/jour, les
#    modèles `:free` restent facturés 0 €.)

# --- Option B : PAYANT (meilleure fidélité, moins de reprises) ---
# LLM_MODEL=anthropic/claude-sonnet-5
#   Autres : anthropic/claude-opus-4.8 · moonshotai/kimi-k3
#            openai/gpt-5.6-terra · qwen/qwen3.7-max · mistralai/mistral-medium-3.5
#   Coût observé : ~0,50 à 2 € par prédication (~35 000 tokens d'entrée,
#   ~15 000 de sortie).

# Choix explicite du fournisseur (optionnel, déduit sinon) :
# LLM_PROVIDER=openrouter

# Plafond de sortie (optionnel). Laisser vide = le fournisseur applique son
# propre maximum, ce qui évite les erreurs 400 sur les modèles gratuits dont
# la sortie est plafonnée plus bas.
# LLM_MAX_TOKENS=

# ── Supabase (Settings → API du projet) ───────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
